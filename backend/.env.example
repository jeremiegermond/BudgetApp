# Server
PORT=3001

# Database (SQLite file path)
DB_PATH=./budget.db

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Enable Banking (PSD2)
# 1. Créez un compte sur https://enablebanking.com
# 2. Créez une application, copiez l'Application ID ci-dessous
# 3. Générez une clé RSA : openssl genrsa -out backend/config/<EB_APP_ID>.pem 2048
# 4. Enregistrez la clé publique dans le dashboard Enable Banking
EB_APP_ID=your-application-id-here
EB_REDIRECT_URL=https://jeremiegermond.github.io/BudgetApp/callback
