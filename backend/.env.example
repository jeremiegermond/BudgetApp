# Server
PORT=3001

# Database (SQLite file path)
DB_PATH=./budget.db

# Nordigen / GoCardless Open Banking
# Créez un compte sur https://ob.nordigen.com
# Allez dans "User Secrets" pour générer vos clés
NORDIGEN_SECRET_ID=your_secret_id_here
NORDIGEN_SECRET_KEY=your_secret_key_here

# URL de votre frontend (pour les redirections OAuth)
FRONTEND_URL=http://localhost:5173
